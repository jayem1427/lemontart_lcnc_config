# Microject injector: stock M7/M8 → coil 1. M9 / abort / Flood-off → coil 0.
# Analog E4/E5/E6 still hold Hz / duty / psi for M101/M102 (laser uses E0-E3).
# Holding-register writes are not enabled yet — firmware defaults (1 ms on /
# 100 ms period) apply as soon as coil 1 is true. See docs/COOLANT.md.

loadusr -Wn microject mb2hal config=microject.mb2hal

addf or2.2 servo-thread

# Enable = flood or mist so either Probe Basic button / M7 / M8 starts spray.
net coolant-flood iocontrol.0.coolant-flood => or2.2.in0
net coolant-mist  iocontrol.0.coolant-mist  => or2.2.in1
net coolant-enable or2.2.out => microject.coolant_run.00.bit
