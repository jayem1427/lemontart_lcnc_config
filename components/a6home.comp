component a6home "StepperOnline A6-EC drive-internal homing glue for stock LinuxCNC index homing";

description """
Lets a CiA 402 drive (StepperOnline A6-EC) home itself, hard stop + Z pulse
(method -1/-2) or Z pulse only (33/34), while LinuxCNC runs its normal
*index-only* homing (HOME_SEARCH_VEL = 0, HOME_LATCH_VEL != 0,
HOME_USE_INDEX = YES). No custom HOMEMOD and no patched homing.c, so the same
module works under stock 2.9.8 and under tpnext.

One instance per drive. It sits between the existing cia402 component (CiA 402
state machine, enable) and lcec:

- When LinuxCNC arms joint.N.index-enable, it requests modes of operation 6,
  waits until the drive reports mode 6 in 0x6061 with operation enabled, then
  sets controlword bit 4 on top of cia402's controlword.
- Homing done = statusword bits 10 and 12, only after the drive was seen busy
  (bit 10 or 12 low) since the start bit, so stale status from an earlier run
  cannot end a new one.
- While the drive moves on its own, motor-pos-fb follows motor-pos-cmd, so
  LinuxCNC sees no following error.
- On done it clears index-enable. With 0x60E6 = 0 and 0x607C = 0 the drive's
  position is 0 at the Z pulse, which is what LinuxCNC's index homing expects
  ("counter reset at index"). LinuxCNC re-bases its command in that same servo
  cycle.
- Back to CSP: until 0x6061 reports CSP again, the drive gets its own actual
  position as target, never LinuxCNC's stale pre-homing target (the Er87.1
  jump other A6 users hit).
- A drive fault, a homing error (statusword bit 13), a missing mode
  acknowledge, a timeout or an ESC abort never clears index-enable (that
  would read as "index found"). Instead amp-fault goes true until LinuxCNC
  has disabled the joint (then it is released, or the machine could never be
  enabled again: LinuxCNC releases index-enable only once it is enabled again).
  The drive holds its own position until LinuxCNC's command matches it.

Thread order: a6home.N.read-all after the feedback scaling and before
motion-command-handler; a6home.N.write-all after motion-controller and after
cia402.N.write-all, before the command scaling and lcec.write-all.
""";

// from the drive / cia402
pin in u32 statusword "0x6041 statusword";
pin in s32 opmode_display "0x6061 modes of operation display";
pin in u32 cw_in "controlword from cia402.N.controlword";
pin in bit drv_fault "cia402.N.drv-fault";
pin in bit amp_enable "joint.N.amp-enable-out (LinuxCNC has the joint enabled)";
pin in float fb_drive "scaled drive position feedback (machine units)";
// from motion
pin in float cmd_joint "joint.N.motor-pos-cmd";
pin io bit index_enable "joint.N.index-enable";
// to the drive
pin out u32 cw_out "controlword to the drive (0x6040)";
pin out s32 opmode = 8 "modes of operation to the drive (0x6060)";
pin out float cmd_drive "position command to the scaling for 0x607A";
// to motion
pin out float fb_joint "joint.N.motor-pos-fb";
pin out bit amp_fault "joint.N.amp-fault-in: drive fault OR homing failure";
// status
pin out bit homing "drive homing in progress";
pin out bit homed "last drive homing finished OK";
pin out bit failed "last drive homing failed (fault, bit 13, no ack, timeout)";
pin out u32 ferr_window "optional: to 0x6065 if mapped in the RxPDO (see DRIVE_HOMING.md, R7)";
pin out s32 hstate "0 idle, 1 request, 2 start, 3 running, 4 handback, 5 error, 6 aborted";

param rw float done_timeout = 40.0 "s from start bit to done before giving up";
param rw float ack_timeout = 1.0 "s to wait for 0x6061 = 6 / 8";
param rw s32 csp_mode = 8 "mode to return to after homing";
param rw s32 joint_no = -1 "joint number, only used in error messages";
param rw u32 ferr_normal = 0 "optional: 0x6065 following-error window outside drive homing (counts)";
param rw u32 ferr_homing = 0 "optional: 0x6065 window while the drive homes (counts); 0 = feature off";

variable int st = 0;
variable double t = 0.0;
variable int seen_busy = 0;
variable int err_reason = 0;
variable int reported = 0;

function read_all fp;
function write_all fp;
license "GPL";
author "lemontart_lcnc_config";
;;

// LOGIC-BEGIN (plain C, extracted by components/test/test_a6home.sh)
#define A6H_IDLE     0
#define A6H_REQUEST  1   /* mode 6 requested, waiting for 0x6061 = 6 */
#define A6H_START    2   /* bit 4 asserted */
#define A6H_RUNNING  3   /* drive homing */
#define A6H_HANDBACK 4   /* drive done, mode 8 requested, index-enable still set */
#define A6H_ERROR    5   /* failed or aborted: amp-fault until LinuxCNC has disabled the joint */
#define A6H_ABORTED  6   /* hold the drive at its own position until LinuxCNC is back in sync */

#define A6H_MODE_HOMING 6
#define A6H_SYNC_TOL    0.01   /* machine units: command vs drive position to leave ABORTED */
#define A6H_RESYNC_TMO  0.5    /* s enabled in ABORTED without sync before forcing another disable */

#define A6H_ERR_NONE    0
#define A6H_ERR_FAULT   1
#define A6H_ERR_BIT13   2
#define A6H_ERR_NOACK   3
#define A6H_ERR_TIMEOUT 4
#define A6H_ERR_ABORT   5
#define A6H_ERR_NOSYNC  6

/* LinuxCNC must not see the drive's own motion: feedback mirrors the command */
static int a6h_mirror(int s) {
    return s == A6H_REQUEST || s == A6H_START || s == A6H_RUNNING || s == A6H_HANDBACK;
}

/* modes of operation to request */
static int a6h_mode(int s, int csp) {
    return (s == A6H_REQUEST || s == A6H_START || s == A6H_RUNNING || s == A6H_ERROR)
           ? A6H_MODE_HOMING : csp;
}

/* Read side: runs before motion. Updates the state, may clear index-enable,
 * and produces the feedback motion sees.
 *
 * LinuxCNC facts this relies on (homing.c / control.c, 2.9 and tpnext):
 * - index-enable is released by LinuxCNC only when its homing state machine
 *   runs, i.e. in FREE mode with the machine enabled. A joint that was
 *   disabled mid-homing keeps index-enable set until the next enable.
 * - an amp fault refuses (and drops) machine enable, so amp-fault must be
 *   released once the joint is disabled, or the machine can't come back.
 * - while disabled, LinuxCNC sets its command to the feedback. */
static void a6h_read(int *s, double *tm, int *busy, int *why,
                     unsigned sw, int opd, int ie_in, int dfault, int amp_en,
                     double fb_drv, double cmd_jnt, double dt,
                     double tmo, double ack_tmo, int csp,
                     int *ie_out, double *fb_jnt, int *amp_flt,
                     int *o_homing, int *o_homed, int *o_error)
{
    int fault = dfault || ((sw >> 3) & 1);
    int op_enabled = (sw & 0x6F) == 0x27;
    int b10 = (sw >> 10) & 1, b12 = (sw >> 12) & 1, b13 = (sw >> 13) & 1;
    int ie = ie_in;
    int busy_state;

    *tm += dt;
    busy_state = (*s == A6H_REQUEST || *s == A6H_START || *s == A6H_RUNNING || *s == A6H_HANDBACK);
    if (busy_state && !amp_en) {
        /* LinuxCNC disabled the joint (machine off, E-stop, another joint's
         * fault): its homing is cancelled. Go straight to holding. */
        *s = A6H_ABORTED; *tm = 0; *why = A6H_ERR_ABORT;
    } else if (busy_state && !ie) {
        /* LinuxCNC aborted homing while enabled (ESC): its command is stale,
         * force a disable so it re-syncs to the real position */
        *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_ABORT;
    } else if (busy_state && fault) {
        *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_FAULT;
    } else switch (*s) {
    case A6H_IDLE:
        if (ie && amp_en) {
            *s = A6H_REQUEST; *tm = 0; *busy = 0; *why = A6H_ERR_NONE;
            *o_homed = 0; *o_error = 0;
        }
        break;
    case A6H_REQUEST:
        if (opd == A6H_MODE_HOMING && op_enabled) { *s = A6H_START; *tm = 0; }
        else if (*tm > ack_tmo) { *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_NOACK; }
        break;
    case A6H_START: /* write side asserted bit 4 after the mode ack */
        *s = A6H_RUNNING;
        break;
    case A6H_RUNNING:
        if (opd == A6H_MODE_HOMING && b13) { *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_BIT13; }
        else {
            /* stale "homed" bits from an earlier run must not end this one */
            if (opd == A6H_MODE_HOMING && (!b10 || !b12)) *busy = 1;
            if (*busy && opd == A6H_MODE_HOMING && b10 && b12) {
                *s = A6H_HANDBACK; *tm = 0;    /* back to CSP first, hold position */
            } else if (*tm > tmo) {
                *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_TIMEOUT;
            }
        }
        break;
    case A6H_HANDBACK:
        if (opd == csp) {
            /* drive is in CSP, holding its own position: now "index found".
             * LinuxCNC re-bases its command onto this feedback in this cycle. */
            ie = 0; *o_homed = 1; *s = A6H_IDLE;
        } else if (*tm > ack_tmo) { *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_NOACK; }
        break;
    case A6H_ERROR:
        /* never clear index-enable (it would read as "index found").
         * amp-fault until LinuxCNC has disabled the joint, then release it. */
        if (!amp_en) { *s = A6H_ABORTED; *tm = 0; }
        break;
    case A6H_ABORTED:
        /* drive holds its own position. Leave once LinuxCNC has released
         * index-enable (first enabled FREE cycle) and its command matches. */
        if (!ie && opd == csp && !fault) {
            double d = cmd_jnt - fb_drv;
            if (d < A6H_SYNC_TOL && -d < A6H_SYNC_TOL) *s = A6H_IDLE;
            else if (amp_en && *tm > A6H_RESYNC_TMO) { *s = A6H_ERROR; *tm = 0; *why = A6H_ERR_NOSYNC; }
        }
        if (!amp_en) *tm = 0;
        break;
    default:
        *s = A6H_IDLE;
    }

    if (*s == A6H_ERROR || *s == A6H_ABORTED) *o_error = 1;
    *ie_out = ie;
    *o_homing = (*s >= A6H_REQUEST && *s <= A6H_HANDBACK);
    *fb_jnt = a6h_mirror(*s) ? cmd_jnt : fb_drv;
    *amp_flt = fault || (*s == A6H_ERROR && amp_en);
}

/* Write side: runs after motion and after cia402.write-all. */
static void a6h_write(int s, unsigned cw, int opd, int csp,
                      double fb_drv, double cmd_jnt,
                      unsigned *cw_o, int *mode_o, double *cmd_drv)
{
    *mode_o = a6h_mode(s, csp);
    *cw_o = cw | ((s == A6H_START || s == A6H_RUNNING) ? 0x10u : 0u);
    /* LinuxCNC's command only when idle and the drive confirms CSP;
     * otherwise the drive holds its own actual position */
    *cmd_drv = (s == A6H_IDLE && opd == csp) ? cmd_jnt : fb_drv;
}
// LOGIC-END

static const char *a6h_why(int w) {
    switch (w) {
    case A6H_ERR_FAULT:   return "drive fault";
    case A6H_ERR_BIT13:   return "drive reports homing error (statusword bit 13)";
    case A6H_ERR_NOACK:   return "drive did not confirm the mode change (0x6061)";
    case A6H_ERR_TIMEOUT: return "timeout";
    case A6H_ERR_ABORT:   return "homing aborted (ESC, machine off or E-stop); drive held at its position";
    case A6H_ERR_NOSYNC:  return "LinuxCNC command did not re-sync with the drive after an abort";
    default:              return "unknown";
    }
}

FUNCTION(read_all) {
    int ie_o = 0, flt = 0, hg = homing, hd = homed, er = failed;
    double fbj = 0.0;
    a6h_read(&st, &t, &seen_busy, &err_reason,
             statusword, opmode_display, index_enable, drv_fault, amp_enable,
             fb_drive, cmd_joint, fperiod,
             done_timeout, ack_timeout, csp_mode,
             &ie_o, &fbj, &flt, &hg, &hd, &er);
    index_enable = ie_o;
    fb_joint = fbj;
    amp_fault = flt;
    homing = hg;
    homed = hd;
    failed = er;
    hstate = st;
    if (st == A6H_IDLE || st == A6H_REQUEST) reported = 0;
    if (er && !reported) {
        rtapi_print_msg(RTAPI_MSG_ERR, "a6home: joint %d drive homing failed: %s (statusword 0x%04x, 0x6061=%d)\n",
                        (int)joint_no, a6h_why(err_reason), (unsigned)statusword, (int)opmode_display);
        reported = 1;
    }
}

FUNCTION(write_all) {
    unsigned cwo = 0;
    int mo = 0;
    double cd = 0.0;
    a6h_write(st, cw_in, opmode_display, csp_mode, fb_drive, cmd_joint, &cwo, &mo, &cd);
    cw_out = cwo;
    opmode = mo;
    cmd_drive = cd;
    /* wider drive following-error window while the drive pushes on its stop */
    ferr_window = (ferr_homing && (st == A6H_REQUEST || st == A6H_START || st == A6H_RUNNING))
                  ? ferr_homing : ferr_normal;
}
