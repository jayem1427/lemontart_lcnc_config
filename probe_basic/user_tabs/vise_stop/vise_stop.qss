/* VISE STOP - Probe Basic look: PB's grey gradient buttons with black borders,
   white entry fields with black text, BebasKai, #2e3436 / #363b3d.
   Colour only means state: green text = selected, amber = attention, red = blocked. */

QWidget#VISE {
    background-color: #2e3436;
    color: rgb(238, 238, 236);
    font: 14pt "BebasKai";
}

QFrame#panel {
    background-color: #363b3d;
    border: 1px solid #1e2122;
    border-radius: 5px;
}
QFrame#panel QLabel { background: transparent; border: none; }

QLabel#panelTitle {
    color: white;
    font: 16pt "BebasKai";
    padding: 6px 14px 4px 14px;
    background-color: #3d4244;
    border: none;
    border-bottom: 1px solid #1e2122;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QLabel#fieldLabel { color: #d3d7cf; font: 14pt "BebasKai"; }

QFrame#sep {
    border: none;
    border-top: 1px solid #1e2122;
    border-bottom: 1px solid #4a4f51;
}

QFrame#dro {
    background-color: #1e2122;
    border: 1px solid black;
    border-radius: 4px;
}
QLabel#droAxis { color: #9a9e9f; font: 16pt "BebasKai"; }
QLabel#droValue { color: white; font: 24pt "BebasKai"; }
QLabel#droMsg { color: #fcaf3e; font: 15pt "BebasKai"; padding: 6px 0; }

QLabel#lblStatus { color: #fcaf3e; font: 16pt "BebasKai"; }

QDoubleSpinBox, QComboBox {
    color: black;
    background: white;
    border: 1px solid black;
    border-radius: 4px;
    padding: 2px 8px;
    font: 16pt "BebasKai";
    selection-background-color: rgb(85, 85, 238);
}
QDoubleSpinBox:focus, QComboBox:focus { border: 2px solid #5555ee; }
QComboBox QAbstractItemView { background: white; color: black; font: 16pt "BebasKai"; }

QPushButton {
    color: white;
    border: 2px solid black;
    border-radius: 5px;
    padding: 4px 12px;
    background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0,
        stop:0 rgba(46, 52, 54, 255), stop:0.5 rgba(82, 82, 83, 255),
        stop:0.86 rgba(82, 82, 83, 255), stop:1 rgba(213, 218, 216, 255));
    font: 15pt "BebasKai";
    min-height: 40px;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3a3f41, stop:1 #2e3436);
}
QPushButton#toggle:checked {
    color: #8ae234;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #202425, stop:0.4 #2e3436, stop:1 #3a3f41);
}
QPushButton#btnGo { font: 20pt "BebasKai"; }
QPushButton#btnRetract { font: 17pt "BebasKai"; }
