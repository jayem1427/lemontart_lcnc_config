/* VISE STOP - Probe Basic dark theme (BebasKai), matches the MQL tab */

QWidget#VISE {
    background-color: #2e3436;
    color: rgb(238, 238, 236);
    font: 13pt "BebasKai";
}

QFrame#headerBar,
QFrame#setupCard,
QFrame#originCard,
QFrame#runCard {
    background-color: #363b3d;
    border: 1px solid #8a8484;
    border-radius: 8px;
}

QFrame#headerBar QLabel,
QFrame#setupCard QLabel,
QFrame#originCard QLabel,
QFrame#runCard QLabel {
    background: transparent;
    border: none;
}

QLabel#lblTitle { color: white; font: 22pt "BebasKai"; }
QLabel#lblSubtitle { color: #9a9e9f; font: 13pt "BebasKai"; padding-top: 6px; }

QFrame#headerBar QLabel#pill {
    color: rgb(238, 238, 236);
    font: 14pt "BebasKai";
    padding: 8px 16px 6px 16px;
    background-color: #4a4f51;
    border: 1px solid #8a8484;
    border-radius: 16px;
}
QFrame#headerBar QLabel#pill[state="on"] { color: #0b2a3a; background-color: #5ec8ff; border-color: #2a8fc4; }
QFrame#headerBar QLabel#pill[state="warn"] { color: #fcaf3e; border-color: #fcaf3e; }

QLabel#cardTitle { color: white; font: 17pt "BebasKai"; }
QLabel#fieldLabel { color: #b8bcbe; font: 14pt "BebasKai"; }
QLabel#value { color: #5ec8ff; font: 18pt "BebasKai"; }
QLabel#bigValue { color: #5ec8ff; font: 32pt "BebasKai"; padding: 10px 0; }
QLabel#hint { color: #9a9e9f; font: 12pt "BebasKai"; }
QLabel#steps { color: rgb(238, 238, 236); font: 15pt "BebasKai"; }
QLabel#lblStatus { color: #fcaf3e; font: 15pt "BebasKai"; padding: 2px 6px; }

QDoubleSpinBox, QComboBox {
    color: black;
    background: white;
    border: 1px solid #4a4f51;
    border-radius: 6px;
    padding: 2px 8px;
    font: 16pt "BebasKai";
    selection-background-color: rgb(85, 85, 238);
}
QDoubleSpinBox:focus, QComboBox:focus { border: 2px solid #5555ee; }
QDoubleSpinBox:disabled { background: #4a4f51; color: rgb(170, 170, 170); }
QComboBox QAbstractItemView { background: white; color: black; font: 16pt "BebasKai"; }

QPushButton {
    color: white;
    border: 2px solid black;
    border-radius: 6px;
    padding: 5px 14px;
    background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0,
        stop:0 rgba(46, 52, 54, 255), stop:0.5 rgba(82, 82, 83, 255),
        stop:0.86 rgba(82, 82, 83, 255), stop:1 rgba(213, 218, 216, 255));
    font: 15pt "BebasKai";
    min-height: 40px;
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5a5f61, stop:1 #2e3436);
}
QPushButton#toggle:checked {
    color: #0b2a3a;
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #2a8fc4, stop:0.5 #5ec8ff, stop:1 #c8ecff);
    border-color: #1d6a92;
}
QPushButton#btnGo {
    font: 22pt "BebasKai";
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #3a3f9e, stop:0.5 #5555ee, stop:1 #9a9eff);
    border-color: #2222aa;
}
QPushButton#btnRetract {
    font: 18pt "BebasKai";
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #4e9a06, stop:0.5 #73d216, stop:1 #c4f08a);
    color: #0f2a05;
    border-color: #2f5d03;
}
