(Vise stop: use the tool in the spindle as a hard stop for a self-centering vise.)
(The vise WCS is never changed: it stays at the vise center, probed once.)
(The tool is parked so a part of the given length ends up centered on that WCS:)
(  pin center = -side x [part length / 2 + tool radius] along the jaws, 0 across them.)
(Retract with o<vise_stop_retract> call after clamping.  See docs/VISE_STOP.md)
(Set by the VISE STOP tab - persistent in linuxcnc.var:)
(  #5580 axis along the jaws: 0 = X, 1 = Y)
(  #5581 part side of the pin: +1 = part toward +, -1 = part toward -)
(  #5583 pin tip Z in the vise WCS - negative = below WCS Z0, e.g. below the jaw tops)
(  #5585 part length along the jaws)
(  #5586 vise WCS: 1 = G54 ... 6 = G59)
(  #5582, #5584, #5587 are no longer used)

o<vise_stop_go> sub
  #<axis> = #5580
  #<side> = #5581
  #<stop_z> = #5583
  #<length> = #5585
  #<wcs> = #5586

  (--- refuse anything we cannot trust - never guess a position ---)
  o100 if [#5400 LE 0]
    (ABORT, Vise stop: no tool in the spindle - load the stop pin with M600 first)
  o100 endif
  o101 if [#5400 EQ #3014]
    (ABORT, Vise stop: touch probe is loaded - use a pin or tool as the stop)
  o101 endif
  #<dia> = #5410
  o102 if [#<dia> LE 0]
    (ABORT, Vise stop: loaded tool has no diameter in the tool table)
  o102 endif
  o103 if [[#<wcs> LT 1] OR [#<wcs> GT 6]]
    (ABORT, Vise stop: vise WCS must be G54 to G59)
  o103 endif
  o104 if [[#<axis> NE 0] AND [#<axis> NE 1]]
    (ABORT, Vise stop: jaw axis must be X or Y)
  o104 endif
  o105 if [[#<side> NE 1] AND [#<side> NE -1]]
    (ABORT, Vise stop: part side must be + or -)
  o105 endif
  o106 if [#<length> LE 0]
    (ABORT, Vise stop: enter the part length along the jaws)
  o106 endif
  o109 if [ABS[#<stop_z>] LT 0.0001]
    (ABORT, Vise stop: PIN TIP Z is not set - enter it in the tab)
  o109 endif

  #<base> = [5201 + 20 * #<wcs>]
  o107 if [[ABS[#[#<base>]] LT 0.0001] OR [ABS[#[#<base> + 1]] LT 0.0001]]
    (ABORT, Vise stop: vise WCS X or Y is zero - probe the vise center into it once)
  o107 endif
  #<wcs_z> = #[#<base> + 2]
  o108 if [ABS[#<wcs_z>] LT 0.0001]
    (ABORT, Vise stop: vise WCS Z is zero - set the vise WCS Z once, e.g. on the jaw tops)
  o108 endif

  G21 G90 G94 G40
  G43 H#5400
  (WCS Z + tool length + active G92 = machine Z of the tip at vise Z0)
  #<z_to_mach> = [#<wcs_z> + #5403 + [#5210 * #5213]]
  o115 if [[#<stop_z> + #<z_to_mach>] GT -1]
    (ABORT, Vise stop: stop Z lands above machine Z0 - check STOP Z and the tool length)
  o115 endif

  (--- pin position in the vise WCS ---)
  #<pin> = [0 - #<side> * [#<length> / 2 + #<dia> / 2]]

  (--- retract, select the vise WCS, go over the pin spot, then down ---)
  #<old_wcs> = #5220
  M5
  G53 G0 Z0

  o130 if [#<wcs> EQ 1]
    G54
  o130 elseif [#<wcs> EQ 2]
    G55
  o130 elseif [#<wcs> EQ 3]
    G56
  o130 elseif [#<wcs> EQ 4]
    G57
  o130 elseif [#<wcs> EQ 5]
    G58
  o130 else
    G59
  o130 endif

  o120 if [#<axis> EQ 0]
    G0 X#<pin> Y0
  o120 else
    G0 X0 Y#<pin>
  o120 endif

  (rapid to 25 mm above the stop only if that stays below machine Z0, then feed)
  o135 if [[#<stop_z> + 25 + #<z_to_mach>] LT -1]
    G0 Z[#<stop_z> + 25]
  o135 endif
  G1 Z#<stop_z> F600

  (restore the coordinate system that was active before)
  o140 if [#<old_wcs> EQ 1]
    G54
  o140 elseif [#<old_wcs> EQ 2]
    G55
  o140 elseif [#<old_wcs> EQ 3]
    G56
  o140 elseif [#<old_wcs> EQ 4]
    G57
  o140 elseif [#<old_wcs> EQ 5]
    G58
  o140 elseif [#<old_wcs> EQ 6]
    G59
  o140 elseif [#<old_wcs> EQ 7]
    G59.1
  o140 elseif [#<old_wcs> EQ 8]
    G59.2
  o140 else
    G59.3
  o140 endif
o<vise_stop_go> endsub

M2
