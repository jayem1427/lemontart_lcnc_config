# =========================================================
# 1. CORE MOTION CONTROLLER
# =========================================================
loadrt [KINS]KINEMATICS
# num_aio=7: E0-E3 laser mailbox, E4-E6 PWM coolant (freq/duty/pressure).
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_aio=7 num_dio=5

# =========================================================
# 2. ETHERCAT DRIVER & HELPERS
# =========================================================
# lcec_conf is loaded in ethercat_loadusr.hal (# NOTWOPASS, first HALFILE in ini).
loadrt lcec
# DRIVE-HOMING: cia402 must be the one from linuxcnc-ethercat >= 1.49.0 (in-tree C port with
# position scaling, mode-6 handshake and stale-homed protection), not the old halcompile'd
# hal-cia402 .comp. Install: scripts/install-drive-homing.sh. Drive homing itself runs in
# [EMCMOT]HOMEMOD = cia402_homecomp (github.com/linuxcnc-ethercat/cia402_homecomp).
loadrt cia402 count=4
# DRIVE-HOMING: conv_*/mult2.0-3/div2.0-3 no longer scale position (cia402 does). Kept loaded and
# un-addf'd so the instance numbers used by custom.hal / coolant.hal / the pendant don't shift.
loadrt conv_real_sint count=4
loadrt conv_sint_real count=4
loadrt conv_uint_real count=1
loadrt mult2 count=12
loadrt ilowpass count=4
loadrt limit1 count=4
loadrt div2 count=4
loadrt not count=11
loadrt and2 count=12
# Separate groups: X home 5 ms (bounce on backoff). Limits / YZ 8 ms.
loadrt debounce cfg=1,3
loadrt oneshot count=2
loadrt flipflop count=2
# DRIVE-HOMING: or2.6/7 = shared home bus guard (section 6). REVERT: count=6
loadrt or2 count=8
loadrt near count=3
loadrt comp count=1
loadrt constant names=probe-tool-num
# Laser timedelay (laser-flute-hold) is loaded with spindle-at-speed-delay in
# custom.hal for SCOPE FILT only — G38 diameter uses RAW beam (see laser block).

# =========================================================
# 3. THREAD EXECUTION ORDER (Read -> Compute -> Write)
# =========================================================
addf lcec.read-all servo-thread
addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread
addf cia402.3.read-all servo-thread
addf laser-flute-hold servo-thread

# Read Inputs
# DRIVE-HOMING: position feedback is scaled by cia402.N.read-all (pos-scale).
# REVERT: addf conv-sint-real.0-3 and div2.0-3 here.
addf and2.0 servo-thread
addf and2.1 servo-thread
addf and2.2 servo-thread
addf and2.3 servo-thread
addf and2.4 servo-thread
addf and2.5 servo-thread
addf and2.6 servo-thread
addf and2.7 servo-thread
addf and2.8 servo-thread
addf or2.0 servo-thread
addf or2.3 servo-thread
addf conv-uint-real.0 servo-thread
addf comp.0 servo-thread
addf probe-tool-num servo-thread
# not.0 is reserved by probe_basic_postgui.hal.
addf not.1 servo-thread
addf not.2 servo-thread
addf not.3 servo-thread
addf not.4 servo-thread
addf not.5 servo-thread
addf not.6 servo-thread
addf not.7 servo-thread
addf not.8 servo-thread
addf not.9 servo-thread
addf not.10 servo-thread
addf debounce.0 servo-thread
addf debounce.1 servo-thread
addf oneshot.0 servo-thread
addf oneshot.1 servo-thread
addf and2.9 servo-thread
addf and2.10 servo-thread
addf and2.11 servo-thread
addf or2.2 servo-thread
addf or2.4 servo-thread
addf flipflop.0 servo-thread
addf flipflop.1 servo-thread
# DRIVE-HOMING: guard must run after the flipflops and before motion. REVERT: delete both.
addf or2.6 servo-thread
addf or2.7 servo-thread
setp debounce.0.delay 5
setp debounce.1.delay 8
setp oneshot.0.width 0.05
setp oneshot.1.width 0.05
setp and2.0.in0 0
setp and2.0.in1 0

# Pendant jog conditioning: limit scale, smooth counts
addf limit1.0 servo-thread
addf mult2.8 servo-thread
addf ilowpass.0 servo-thread
addf limit1.1 servo-thread
addf mult2.9 servo-thread
addf ilowpass.1 servo-thread
addf limit1.2 servo-thread
addf mult2.10 servo-thread
addf ilowpass.2 servo-thread
addf limit1.3 servo-thread
addf mult2.11 servo-thread
addf ilowpass.3 servo-thread

# Core Motion Compute
addf motion-command-handler servo-thread
addf motion-controller servo-thread

# DRIVE-HOMING: position command is scaled by cia402.N.write-all (pos-scale).
# REVERT: addf mult2.0-3 and conv-real-sint.0-3 here.

# Write to Drives
addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread
addf cia402.3.write-all servo-thread
addf lcec.write-all servo-thread
# tpnext/lcec 2.10: activate master in RT init context before threads start
# (avoids inline-activation + bang-bang PLL DC trim fallback).
initf lcec.activate servo-thread

# =========================================================
# 4. HARDWARE PIN ROUTING & STATE MACHINES
# =========================================================

# DRIVE-HOMING START (branch dev-drive-homing, docs/DRIVE_HOMING.md)
# Each joint: cia402 (lcec >= 1.49) owns controlword, modes of operation (6060/6061), position
# scaling and the drive's homing handshake. cia402_homecomp ([EMCMOT]HOMEMOD) owns LinuxCNC's
# homing: it requests drive homing through cia402.N.home, presents the command as feedback while
# the drive moves on its own, and re-syncs LinuxCNC to the drive at the end or on any abort.
# auto-fault-reset 0 keeps the old behaviour (the old hal-cia402 defaulted to 0; lcec's is 1):
# a drive fault is NOT cleared automatically by the next Machine On.
# REVERT (switch homing, old scaling): check out dev-jerk-testing.
# --- X AXIS (Slave 0) ---
setp cia402.0.pos-scale        [JOINT_0]SCALE
setp cia402.0.auto-fault-reset 0
net x-pos-s32-fb       lcec.0.0.pos-fb             => cia402.0.drv-actual-position
net x-pos-s32-cmd      cia402.0.drv-target-position => lcec.0.0.pos-cmd
net x-pos-float-cmd    joint.0.motor-pos-cmd        => cia402.0.pos-cmd joint.0.cia-pos-cmd
net x-vel-cmd          joint.0.vel-cmd              => cia402.0.velocity-cmd joint.0.cia-velocity-cmd
net x-pos-float-fb-drv cia402.0.pos-fb              => joint.0.cia-pos-fb-in
net x-pos-float-fb     joint.0.cia-pos-fb-out       => joint.0.motor-pos-fb

net x-status-word      lcec.0.0.status-word         => cia402.0.statusword
net x-ctrl-word        cia402.0.controlword         => lcec.0.0.ctrl-word
net x-opmode           cia402.0.opmode              => lcec.0.0.opmode
net x-opmode-disp      lcec.0.0.opmode-display      => cia402.0.opmode-display joint.0.cia-opmode-display
net x-amp-enable-cmd   joint.0.amp-enable-out       => joint.0.cia-enable-in
net x-amp-enable       joint.0.cia-enable-out       => cia402.0.enable
# If the machine faults at enable with no drive alarm, comment these four drv-fault nets out.
net x-amp-fault        cia402.0.drv-fault           => joint.0.amp-fault-in

net x-home             joint.0.cia-home            <=> cia402.0.home
net x-stat-homed       cia402.0.stat-homed          => joint.0.cia-stat-homed
net x-stat-homing      cia402.0.stat-homing         => joint.0.cia-stat-homing
net x-stat-home-err    cia402.0.stat-homing-error   => joint.0.cia-stat-homing-error
net x-stat-fault       cia402.0.stat-fault          => joint.0.cia-stat-fault
net x-stat-op-en       cia402.0.stat-op-enabled     => joint.0.cia-stat-op-enabled
# 1 = the drive homes this joint, 0 = LinuxCNC switch homing. TRAP: with 0 here AND
# HOME_SEARCH_VEL = HOME_LATCH_VEL = 0 in the INI, the joint is marked homed WHERE IT STANDS.
# Check joint.0.is-custom-homing against the INI before homing (test H1).
setp joint.0.request-custom-homing [JOINT_0]DRIVE_HOME_ENABLE
setp joint.0.cia-timeout-ms      [JOINT_0]DRIVE_HOME_TIMEOUT_MS
# Drive-side homing settings, sent every cycle over the RxPDO (see ethercat-conf.xml)
setp lcec.0.0.home-method      [JOINT_0]DRIVE_HOME_METHOD
setp lcec.0.0.home-speed-fast  [JOINT_0]DRIVE_HOME_SPEED_FAST
setp lcec.0.0.home-speed-slow  [JOINT_0]DRIVE_HOME_SPEED_SLOW
setp lcec.0.0.home-accel       [JOINT_0]DRIVE_HOME_ACCEL
setp lcec.0.0.home-offset      0
setp lcec.0.0.home-calc-method 0

# --- Y AXIS (Slave 1) ---
setp cia402.1.pos-scale        [JOINT_1]SCALE
setp cia402.1.auto-fault-reset 0
net y-pos-s32-fb       lcec.0.1.pos-fb             => cia402.1.drv-actual-position
net y-pos-s32-cmd      cia402.1.drv-target-position => lcec.0.1.pos-cmd
net y-pos-float-cmd    joint.1.motor-pos-cmd        => cia402.1.pos-cmd joint.1.cia-pos-cmd
net y-vel-cmd          joint.1.vel-cmd              => cia402.1.velocity-cmd joint.1.cia-velocity-cmd
net y-pos-float-fb-drv cia402.1.pos-fb              => joint.1.cia-pos-fb-in
net y-pos-float-fb     joint.1.cia-pos-fb-out       => joint.1.motor-pos-fb

net y-status-word      lcec.0.1.status-word         => cia402.1.statusword
net y-ctrl-word        cia402.1.controlword         => lcec.0.1.ctrl-word
net y-opmode           cia402.1.opmode              => lcec.0.1.opmode
net y-opmode-disp      lcec.0.1.opmode-display      => cia402.1.opmode-display joint.1.cia-opmode-display
net y-amp-enable-cmd   joint.1.amp-enable-out       => joint.1.cia-enable-in
net y-amp-enable       joint.1.cia-enable-out       => cia402.1.enable
# If the machine faults at enable with no drive alarm, comment these four drv-fault nets out.
net y-amp-fault        cia402.1.drv-fault           => joint.1.amp-fault-in

net y-home             joint.1.cia-home            <=> cia402.1.home
net y-stat-homed       cia402.1.stat-homed          => joint.1.cia-stat-homed
net y-stat-homing      cia402.1.stat-homing         => joint.1.cia-stat-homing
net y-stat-home-err    cia402.1.stat-homing-error   => joint.1.cia-stat-homing-error
# Shared bus guard: abort a Y drive home that starts with the Y/Z home bus already closed
# (flipflop.1, section 6). The module reports it as "drive fault"; the machine stays on.
net y-stat-fault       cia402.1.stat-fault          => or2.6.in0
net y-bus-at-start     flipflop.1.out               => or2.6.in1
net y-home-abort       or2.6.out                    => joint.1.cia-stat-fault
net y-stat-op-en       cia402.1.stat-op-enabled     => joint.1.cia-stat-op-enabled
# 1 = the drive homes this joint, 0 = LinuxCNC switch homing. TRAP: with 0 here AND
# HOME_SEARCH_VEL = HOME_LATCH_VEL = 0 in the INI, the joint is marked homed WHERE IT STANDS.
# Check joint.1.is-custom-homing against the INI before homing (test H1).
setp joint.1.request-custom-homing [JOINT_1]DRIVE_HOME_ENABLE
setp joint.1.cia-timeout-ms      [JOINT_1]DRIVE_HOME_TIMEOUT_MS
# Drive-side homing settings, sent every cycle over the RxPDO (see ethercat-conf.xml)
setp lcec.0.1.home-method      [JOINT_1]DRIVE_HOME_METHOD
setp lcec.0.1.home-speed-fast  [JOINT_1]DRIVE_HOME_SPEED_FAST
setp lcec.0.1.home-speed-slow  [JOINT_1]DRIVE_HOME_SPEED_SLOW
setp lcec.0.1.home-accel       [JOINT_1]DRIVE_HOME_ACCEL
setp lcec.0.1.home-offset      0
setp lcec.0.1.home-calc-method 0

# --- Z AXIS (Slave 2) ---
setp cia402.2.pos-scale        [JOINT_2]SCALE
setp cia402.2.auto-fault-reset 0
net z-pos-s32-fb       lcec.0.2.pos-fb             => cia402.2.drv-actual-position
net z-pos-s32-cmd      cia402.2.drv-target-position => lcec.0.2.pos-cmd
net z-pos-float-cmd    joint.2.motor-pos-cmd        => cia402.2.pos-cmd joint.2.cia-pos-cmd
net z-vel-cmd          joint.2.vel-cmd              => cia402.2.velocity-cmd joint.2.cia-velocity-cmd
net z-pos-float-fb-drv cia402.2.pos-fb              => joint.2.cia-pos-fb-in
net z-pos-float-fb     joint.2.cia-pos-fb-out       => joint.2.motor-pos-fb

net z-status-word      lcec.0.2.status-word         => cia402.2.statusword
net z-ctrl-word        cia402.2.controlword         => lcec.0.2.ctrl-word
net z-opmode           cia402.2.opmode              => lcec.0.2.opmode
net z-opmode-disp      lcec.0.2.opmode-display      => cia402.2.opmode-display joint.2.cia-opmode-display
net z-amp-enable-cmd   joint.2.amp-enable-out       => joint.2.cia-enable-in
net z-amp-enable       joint.2.cia-enable-out       => cia402.2.enable
# If the machine faults at enable with no drive alarm, comment these four drv-fault nets out.
net z-amp-fault        cia402.2.drv-fault           => joint.2.amp-fault-in

net z-home             joint.2.cia-home            <=> cia402.2.home
net z-stat-homed       cia402.2.stat-homed          => joint.2.cia-stat-homed
net z-stat-homing      cia402.2.stat-homing         => joint.2.cia-stat-homing
net z-stat-home-err    cia402.2.stat-homing-error   => joint.2.cia-stat-homing-error
# Shared bus guard, as on Y (flipflop.0).
net z-stat-fault       cia402.2.stat-fault          => or2.7.in0
net z-bus-at-start     flipflop.0.out               => or2.7.in1
net z-home-abort       or2.7.out                    => joint.2.cia-stat-fault
net z-stat-op-en       cia402.2.stat-op-enabled     => joint.2.cia-stat-op-enabled
# 1 = the drive homes this joint, 0 = LinuxCNC switch homing. TRAP: with 0 here AND
# HOME_SEARCH_VEL = HOME_LATCH_VEL = 0 in the INI, the joint is marked homed WHERE IT STANDS.
# Check joint.2.is-custom-homing against the INI before homing (test H1).
setp joint.2.request-custom-homing [JOINT_2]DRIVE_HOME_ENABLE
setp joint.2.cia-timeout-ms      [JOINT_2]DRIVE_HOME_TIMEOUT_MS
# Drive-side homing settings, sent every cycle over the RxPDO (see ethercat-conf.xml)
setp lcec.0.2.home-method      [JOINT_2]DRIVE_HOME_METHOD
setp lcec.0.2.home-speed-fast  [JOINT_2]DRIVE_HOME_SPEED_FAST
setp lcec.0.2.home-speed-slow  [JOINT_2]DRIVE_HOME_SPEED_SLOW
setp lcec.0.2.home-accel       [JOINT_2]DRIVE_HOME_ACCEL
setp lcec.0.2.home-offset      0
setp lcec.0.2.home-calc-method 0

# --- A AXIS (Slave 3) ---
setp cia402.3.pos-scale        [JOINT_3]SCALE
setp cia402.3.auto-fault-reset 0
net a-pos-s32-fb       lcec.0.3.pos-fb             => cia402.3.drv-actual-position
net a-pos-s32-cmd      cia402.3.drv-target-position => lcec.0.3.pos-cmd
net a-pos-float-cmd    joint.3.motor-pos-cmd        => cia402.3.pos-cmd joint.3.cia-pos-cmd
net a-vel-cmd          joint.3.vel-cmd              => cia402.3.velocity-cmd joint.3.cia-velocity-cmd
net a-pos-float-fb-drv cia402.3.pos-fb              => joint.3.cia-pos-fb-in
net a-pos-float-fb     joint.3.cia-pos-fb-out       => joint.3.motor-pos-fb

net a-status-word      lcec.0.3.status-word         => cia402.3.statusword
net a-ctrl-word        cia402.3.controlword         => lcec.0.3.ctrl-word
net a-opmode           cia402.3.opmode              => lcec.0.3.opmode
net a-opmode-disp      lcec.0.3.opmode-display      => cia402.3.opmode-display joint.3.cia-opmode-display
net a-amp-enable-cmd   joint.3.amp-enable-out       => joint.3.cia-enable-in
net a-amp-enable       joint.3.cia-enable-out       => cia402.3.enable
# If the machine faults at enable with no drive alarm, comment these four drv-fault nets out.
net a-amp-fault        cia402.3.drv-fault           => joint.3.amp-fault-in

net a-home             joint.3.cia-home            <=> cia402.3.home
net a-stat-homed       cia402.3.stat-homed          => joint.3.cia-stat-homed
net a-stat-homing      cia402.3.stat-homing         => joint.3.cia-stat-homing
net a-stat-home-err    cia402.3.stat-homing-error   => joint.3.cia-stat-homing-error
net a-stat-fault       cia402.3.stat-fault          => joint.3.cia-stat-fault
net a-stat-op-en       cia402.3.stat-op-enabled     => joint.3.cia-stat-op-enabled
# 1 = the drive homes this joint, 0 = LinuxCNC switch homing. TRAP: with 0 here AND
# HOME_SEARCH_VEL = HOME_LATCH_VEL = 0 in the INI, the joint is marked homed WHERE IT STANDS.
# Check joint.3.is-custom-homing against the INI before homing (test H1).
setp joint.3.request-custom-homing [JOINT_3]DRIVE_HOME_ENABLE
setp joint.3.cia-timeout-ms      [JOINT_3]DRIVE_HOME_TIMEOUT_MS
# Drive-side homing settings, sent every cycle over the RxPDO (see ethercat-conf.xml)
setp lcec.0.3.home-method      [JOINT_3]DRIVE_HOME_METHOD
setp lcec.0.3.home-speed-fast  [JOINT_3]DRIVE_HOME_SPEED_FAST
setp lcec.0.3.home-speed-slow  [JOINT_3]DRIVE_HOME_SPEED_SLOW
setp lcec.0.3.home-accel       [JOINT_3]DRIVE_HOME_ACCEL
setp lcec.0.3.home-offset      0
setp lcec.0.3.home-calc-method 0

# DRIVE-HOMING END

# =========================================================
# 5. TOOL PREP / MANUAL TOOL CHANGE (Probe Basic postgui)
# =========================================================
# The dummy estop loop is removed because we use a physical switch below
net tool-prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
# TooTall18T Integration — M6 opens tool-change OK dialog; do not auto-confirm tool-changed
net tool-change-request <= iocontrol.0.tool-change
net tool-change-confirmed => iocontrol.0.tool-changed
net tool-number iocontrol.0.tool-prep-number

# =========================================================
# 6. PHYSICAL LIMIT & HOME SWITCH WIRING
# =========================================================
# Physical map QC 2026-10 (active-low NC -> not.* -> joint.* TRUE when tripped):
#   X home  lcec.0.0.di-2 | X limit lcec.0.0.di-5
#   Y limit lcec.0.0.di-1 (hijacked former Z- limit DI — Y lim on 0.1.di-1 was dead/shorted)
#   Y home shares Z-home short bus (see below)
#   Z home  lcec.0.1.di-4 (also 0.0.di-3/4 + 0.1.di-3 — shorted together)
#   Z- lim  gagged (no free DI) | Z+ lim none | A home/limits gagged
# Y+Z home shorted is OK: home one axis at a time (HOME_SEQUENCE Z->X->Y).
# DRIVE-HOMING: with drive homing the DRIVE reads the bus, and it can't ignore anything. A home
# that starts with the bus closed would send the drive the wrong way looking for the switch to
# open (Y toward +, Z DOWN), so the same flipflops abort it instead (or2.6/or2.7, section 4):
# jog whichever of Y/Z is on its switch off it, then home again.
# Switch homing (DRIVE_HOME_ENABLE = 0): if the shared bus is already closed at REF, ignore it until it has been
# seen open, then latch the next close. Stops Y latching in place and Z
# backing off down. not.9 is laser mux; not.3/10 used by that ignore logic.

# --- X home + limit ---
net x-home-raw   lcec.0.0.di-2 => not.1.in
net x-home-fast  not.1.out => debounce.0.0.in
net x-home       debounce.0.0.out => joint.0.home-sw-in
net j0-homing    joint.0.homing => not.5.in
net j0-lim-on    not.5.out => and2.1.in1
net x-limit-raw  lcec.0.0.di-5 => not.2.in
net x-limit-inv  not.2.out => and2.1.in0
net x-limit-fast and2.1.out => debounce.1.0.in
net x-limit      debounce.1.0.out => joint.0.neg-lim-sw-in joint.0.pos-lim-sw-in

# --- Y limit (on former Z- DI); Y home on shared Y/Z home bus ---
net y-limit-raw  lcec.0.0.di-1 => not.4.in
net j1-homing    joint.1.homing => not.8.in oneshot.1.in
net j1-lim-on    not.8.out => and2.5.in1 or2.4.in1
net y-limit-inv  not.4.out => and2.5.in0
net y-limit-fast and2.5.out => debounce.1.1.in
net y-limit      debounce.1.1.out => joint.1.neg-lim-sw-in joint.1.pos-lim-sw-in

# --- Z home (+Y home on same electrical net); Z- limit gagged ---
net yz-home-raw  lcec.0.1.di-4 => not.7.in
net yz-home-fast not.7.out => debounce.1.2.in
net yz-home      debounce.1.2.out => not.3.in and2.6.in1 and2.9.in1 and2.10.in1 and2.11.in1
net yz-home-open not.3.out => or2.2.in0 or2.4.in0

# Ignore shared bus at the instant homing starts if it is already closed.
net j2-homing    joint.2.homing => oneshot.0.in not.10.in
net z-not-homing not.10.out => or2.2.in1
net z-ignore-set oneshot.0.out => and2.9.in0
net y-ignore-set oneshot.1.out => and2.10.in0
net z-ignore-arm and2.9.out => flipflop.0.set
net y-ignore-arm and2.10.out => flipflop.1.set
net z-ignore-clr or2.2.out => flipflop.0.reset
net y-ignore-clr or2.4.out => flipflop.1.reset
net z-home-ok    flipflop.0.out-not => and2.11.in0
net y-home-ok    flipflop.1.out-not => and2.6.in0
net z-home-sw    and2.11.out => joint.2.home-sw-in
net y-home-sw    and2.6.out => joint.1.home-sw-in

# --- A + Z- still gagged; no +Z limit ---
# and2.0 inputs held 0 -> out FALSE
net a-lims-gagged and2.0.out => joint.2.neg-lim-sw-in joint.2.pos-lim-sw-in joint.3.home-sw-in joint.3.neg-lim-sw-in joint.3.pos-lim-sw-in

# --- TOUCH PROBE + TOOLSETTER + LASER (active-high at trip -> motion.probe-input) ---
# Physical map (QC 2026-10): touch probe = Slave1 DI2; toolsetter = Slave1 DI5.
# Older silk/docs had these swapped — HAL follows the wires; do not re-pin CN1.
# NC (NPN): idle closed = di inactive; trip open = di TRUE. Direct, no inversion.
# Route by spindle tool: T99 -> touch probe; any other tool -> toolsetter.
# probe_beep.hal listens to probe-in downstream of this mux, so beep follows HAL.
# Laser DS-5V-M on Slave 2 DI5: raw laser-beam-broken → LED/M66; debounced → G38.
# Laser G38: M62 P0 enables motion.digital-out-00 -> routes laser to probe-input;
# M63 P0 restores contact mux only. Contact path is disabled while laser mode is on.
setp probe-tool-num.value 99
setp comp.0.hyst 0.1
net spindle-tool halui.tool.number => conv-uint-real.0.in
net spindle-tool-float conv-uint-real.0.out => comp.0.in0
net probe-tool-num-val probe-tool-num.out => comp.0.in1
net probe-tool-loaded comp.0.equal => and2.3.in0
net touch-probe-in   lcec.0.1.di-2 => and2.3.in1
net touch-probe-active and2.3.out => or2.0.in0
net probe-tool-loaded comp.0.equal => not.6.in
net cutter-loaded not.6.out => and2.4.in0
net toolsetter-in    lcec.0.1.di-5 => and2.4.in1
net toolsetter-active and2.4.out => or2.0.in1
net contact-probe-mux or2.0.out => and2.8.in0
net laser-probe-en    motion.digital-out-00 => not.9.in and2.7.in1
net contact-probe-arm not.9.out => and2.8.in1
net contact-probe-trip and2.8.out => or2.3.in1
net laser-probe-trip  and2.7.out => or2.3.in0
net probe-in          or2.3.out => motion.probe-input

# --- LASER DS-5V-M (Slave 2 DI5 / DB15 pin 11) ---
# HCMOS 5 V — level-shift before the A6 DI. TRUE when tool blocks the beam.
# If your DI is TRUE when clear instead, insert not.N on the di-5 -> laser-beam-broken net.
#
# Raw → LED / M66 P3 (instant). timedelay envelope → G38 mux + M66 P4.
# on-delay=0 (trip on first flute), off-delay bridges gullets ([LASER]BEAM_OFF_DELAY).
# Needed so G38.5 can feed through to a true exit clear + 1 mm backside start.
# digital-in-04 = FILT so macros can wait for probe-path clear before G38
# (RAW clear alone is not enough — avoids silent instant trips / no beep).
setp laser-flute-hold.on-delay 0
setp laser-flute-hold.off-delay [LASER]BEAM_OFF_DELAY
net laser-beam-broken     lcec.0.2.di-5 => motion.digital-in-03 laser-flute-hold.in
net laser-beam-filtered   laser-flute-hold.out => and2.7.in0 motion.digital-in-04

# Standard Software GUI E-Stop Loop (Physical Master E-Stop cuts Mains Power)
# Software E-stop switch is NC on Slave 3 DI1 / DB15 pin 10.
# Closed switch keeps lcec.0.3.di-1 TRUE; opening the switch drops LinuxCNC enable.
net estop-ui-ok   iocontrol.0.user-enable-out => and2.2.in0
net estop-sw-ok   lcec.0.3.di-1 => and2.2.in1
net estop-loop    and2.2.out => iocontrol.0.emc-enable-in
